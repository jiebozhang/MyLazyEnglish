# Room, Media3 and Compose ship consumer rules; retain them through the normal
# optimized Android defaults. Room loads the generated database by class name.
-keepattributes Signature,InnerClasses,EnclosingMethod
-keep class * extends androidx.room.RoomDatabase { *; }

# Persisted enum identifiers are part of the Room/DataStore/JSON wire format.
# Keep their constants and lookup methods, without retaining entire packages.
-keepclassmembers enum com.lazyeng.family.** {
    public static ** *;
    public static **[] values();
    public static ** valueOf(java.lang.String);
}

# Entity/DTO access is generated by Room or explicitly mapped with org.json
# put/get keys; it does not use reflective field serialization. AndroidX brings
# kotlinx.serialization transitively with its consumer rules, but V1.0 defines
# no @Serializable business DTOs and uses no Gson. Reassess generated serializer
# and companion rules when adding annotated business models.
